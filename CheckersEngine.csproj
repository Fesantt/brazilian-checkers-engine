<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <Optimize>true</Optimize>
    <AssemblyName>CheckersEngine</AssemblyName>
    <RootNamespace>CheckersEngine</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Version>1.0.0</Version>
    <Authors>Fesantt</Authors>
    <Description>Brazilian Checkers (Damas Brasileiras) engine library — PVS, aspiration windows, TT, LMR, killer moves, history heuristic, quiescence search.</Description>
    <PackageTags>checkers;damas;brazilian-checkers;game-engine;pvs;alpha-beta</PackageTags>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
</Project>
